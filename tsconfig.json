{
    "extends": "astro/tsconfigs/strictest",
    "compilerOptions": {
        "jsx": "preserve",
        "jsxImportSource": "solid-js",
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@/app/*": ["src/app/*"],
            "@/features/*": ["src/features/*"],
            "@/shared/*": ["src/shared/*"],
            "@panda/*": [".panda/*"]
        },
        "verbatimModuleSyntax": false,
        "isolatedModules": false,
        "types": ["unplugin-icons/types/solid"]
    },
    "exclude": ["dist"]
}
