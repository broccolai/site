{
    "name": "site",
    "scripts": {
        "prepare": "panda codegen",
        "dev": "vite --host 0.0.0.0 --port 4321",
        "build": "bun run prepare && vite build",
        "start": "vite preview --host 0.0.0.0 --port 4321",
        "check": "tsc --noEmit",
        "lint": "biome check src package.json tsconfig.json biome.json panda.config.ts vite.config.ts postcss.config.cjs",
        "format": "biome format --write ."
    },
    "type": "module",
    "devDependencies": {
        "@biomejs/biome": "^2.5.12",
        "@pandacss/dev": "^1.12.1",
        "@solidjs/vite-plugin": "3.0.0-next.38",
        "@types/node": "^26.4.1",
        "postcss": "^8.5.28",
        "typescript": "^6.0.3",
        "vite": "^8.2.2"
    },
    "dependencies": {
        "@fontsource/instrument-serif": "^5.3.0",
        "@fontsource/pt-mono": "^5.3.0",
        "@solidjs/web": "2.0.0-rc.6",
        "solid-js": "2.0.0-rc.6"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "trustedDependencies": [
        "@biomejs/biome",
        "esbuild"
    ]
}
