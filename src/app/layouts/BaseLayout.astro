---
import { getPageChrome } from '@/app/site';
import SiteShell from '@/app/layouts/SiteShell.astro';
const { title } = Astro.props;
const chrome = getPageChrome('home');
---

<SiteShell
    title={title}
    headerTitle={chrome.headerTitle}
    alwaysShowHeader={chrome.alwaysShowHeader}
    usePanelScroller
    panelCount={chrome.panelCount}
>
    <slot />
</SiteShell>
